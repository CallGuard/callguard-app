{
  "name": "callguard-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "latest",
    "@react-native-async-storage/async-storage": "latest",
    "@react-navigation/native": "latest",
    "@react-navigation/native-stack": "latest",
    "axios": "latest",
    "expo": "latest",
    "expo-constants": "latest",
    "expo-linking": "latest",
    "expo-modules-core": "latest",
    "expo-router": "latest",
    "expo-sqlite": "latest",
    "expo-status-bar": "latest",
    "expo-task-manager": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-native": "latest",
    "react-native-safe-area-context": "latest",
    "react-native-screens": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@babel/core": "latest",
    "@testing-library/jest-native": "latest",
    "@testing-library/react-native": "latest",
    "@types/jest": "latest",
    "@types/react": "latest",
    "@types/react-native": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "babel-plugin-module-resolver": "latest",
    "eslint": "latest",
    "eslint-config-universe": "latest",
    "jest": "latest",
    "jest-expo": "latest",
    "prettier": "latest",
    "typescript": "latest"
  },
  "private": false,
  "license": "MIT",
  "author": "CallGuard Open Source Community",
  "description": "Um firewall invisível para bloqueio de chamadas de bots e fraudadores em React Native.",
  "keywords": [
    "react-native",
    "expo",
    "call-screening",
    "anti-spam",
    "fraud-prevention",
    "typescript",
    "open-source"
  ]
}
