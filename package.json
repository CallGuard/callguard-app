    "expo-modules-core": "~1.12.0",
    "expo-router": "~3.5.0",
    "expo-sqlite": "~14.0.3",
    "expo-status-bar": "~1.12.1",
    "expo-task-manager": "~11.8.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.1",
